{
    "name": "edrisaturay/filament-starter",
    "description": "A reusable Filament starter package.",
    "homepage": "https://github.com/edrisaturay/filament-starter",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Edrisa A Turay",
            "email": "edrisa@edrisa.com"
        }
    ],
    "support": {
        "issues": "https://github.com/edrisaturay/filament-starter/issues",
        "source": "https://github.com/edrisaturay/filament-starter"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0",
        "a909m/filament-statefusion": "^2.3",
        "achyutn/filament-log-viewer": "^2.1",
        "alizharb/filament-activity-log": "^1.2",
        "asmit/resized-column": "^2.1",
        "bezhansalleh/filament-shield": "^4.2",
        "charrafimed/global-search-modal": "^5.0",
        "cheesegrits/filament-phone-numbers": "^2.1",
        "croustibat/filament-jobs-monitor": "^4.1",
        "jeffgreco13/filament-breezy": "^3.2",
        "pxlrbt/filament-environment-indicator": "^3.4",
        "rickdbcn/filament-email": "^2.2",
        "shuvroroy/filament-spatie-laravel-backup": "^3.4",
        "shuvroroy/filament-spatie-laravel-health": "^3.3",
        "stechstudio/filament-impersonate": "^5.0",
        "tapp/filament-authentication-log": "^5.0",
        "watheqalshowaiter/filament-sticky-table-header": "^1.4",
        "tapp/filament-progress-bar-column": "^1.0",
        "swisnl/filament-backgrounds": "^2.0",
        "promethys/revive": "^3.0",
        "cocosmos/filament-quick-add-select": "^1.0",
        "edrisaturay/filament-api-docs-builder": "*",
        "edrisaturay/filament-utilities": "dev-main",
        "tomatophp/filament-users": "^5.0",
        "bezhansalleh/filament-panel-switch": "^3.1",
        "bezhansalleh/filament-language-switch": "^4.3",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "filament/spatie-laravel-tags-plugin": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "slimani/filament-media-manager": "^0.13|^1.0",
        "mradder/filament-logger": "^1.0",
        "zvizvi/filament-column-filters": "^0.0.6"
    },
    "autoload": {
        "psr-4": {
            "EdrisaTuray\\FilamentStarter\\": "src/",
            "EdrisaTuray\\FilamentStarter\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EdrisaTuray\\FilamentStarter\\StarterServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../filament-api-docs",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../filament-utilities",
            "options": {
                "symlink": true
            }
        }
    ]
}
